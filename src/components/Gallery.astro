---
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { media, title, orientation } = project.data;
const portrait = orientation === 'portrait';
const slides = await Promise.all(
  media.map(async (m) =>
    'video' in m ? { ...m, posterUrl: (await getImage({ src: m.poster, width: 1280, format: 'webp' })).src } : m,
  ),
);
---

<section class:list={['gallery', { portrait }]} aria-roledescription="carousel" aria-label={`${title} media`} data-gallery>
  <div class="track" tabindex="0" data-track>
    {
      slides.map((s, i) => (
        <figure class="slide" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`}>
          {'video' in s ? (
            <video
              src={s.video}
              poster={s.posterUrl}
              aria-label={s.alt}
              muted
              loop
              playsinline
              controls
              preload="none"
              data-autoplay
            />
          ) : (
            <Image
              src={s.image}
              alt={s.alt}
              widths={[640, 960, 1280, 1920]}
              sizes="(min-width: 72rem) 72rem, 100vw"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          )}
        </figure>
      ))
    }
  </div>
  {
    slides.length > 1 && (
      <div class="controls">
        <button class="nav" type="button" aria-label="Previous" data-prev>
          <Icon name="mdi:chevron-left" size={22} />
        </button>
        <p class="counter" aria-live="polite">
          <span data-current>1</span> / {slides.length}
        </p>
        <button class="nav" type="button" aria-label="Next" data-next>
          <Icon name="mdi:chevron-right" size={22} />
        </button>
      </div>
    )
  }
</section>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const videoObserver = new IntersectionObserver(
    (entries) => {
      for (const { target, isIntersecting } of entries) {
        const video = target as HTMLVideoElement;
        if (isIntersecting && !reduceMotion.matches) {
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      }
    },
    { threshold: 0.6 },
  );

  document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((v) => videoObserver.observe(v));

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const track = gallery.querySelector<HTMLElement>('[data-track]')!;
    const slides = [...track.children] as HTMLElement[];
    const current = gallery.querySelector<HTMLElement>('[data-current]');
    const prev = gallery.querySelector<HTMLButtonElement>('[data-prev]');
    const next = gallery.querySelector<HTMLButtonElement>('[data-next]');
    if (!current || !prev || !next) return;

    let index = 0;
    const update = () => {
      current.textContent = String(index + 1);
      prev.disabled = index === 0;
      next.disabled = index === slides.length - 1;
    };
    const go = (i: number) => {
      const target = slides[Math.max(0, Math.min(slides.length - 1, i))];
      track.scrollTo({ left: target.offsetLeft - track.offsetLeft, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
    };

    const slideObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            index = slides.indexOf(entry.target as HTMLElement);
            update();
          }
        }
      },
      { root: track, threshold: 0.6 },
    );
    slides.forEach((s) => slideObserver.observe(s));

    prev.addEventListener('click', () => go(index - 1));
    next.addEventListener('click', () => go(index + 1));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        go(index - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        go(index + 1);
      }
    });
    update();
  });
</script>

<style>
  .gallery {
    margin-block: 2rem 2.5rem;
  }

  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    border-radius: var(--radius);
    background: var(--media-bg);
    box-shadow: var(--shadow);
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .slide {
    flex: 0 0 100%;
    margin: 0;
    position: relative;
    aspect-ratio: 16 / 9;
    scroll-snap-align: center;
  }

  .portrait .track {
    width: min(100%, 22rem);
    margin-inline: auto;
  }

  .portrait .slide {
    aspect-ratio: 9 / 16;
  }

  .slide img,
  .slide video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.9rem;
  }

  .counter {
    margin: 0;
    min-width: 4rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }

  .nav {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }

  .nav:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .nav:disabled {
    opacity: 0.35;
    cursor: default;
  }
</style>
